generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model Photo {
  id          String   @id @default(uuid()) @db.Uuid
  imageUrl    String   @map("image_url")
  altText    String?  @map("alt_text")
  description String?
  category    String
  subcategory String?
  position    Int
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([category, subcategory])
  @@index([position])
  @@map("photos")
}

model Client {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  logoUrl   String   @map("logo_url")
  website   String?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([position])
  @@map("clients")
}
