generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}
